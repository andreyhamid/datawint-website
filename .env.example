# Variables de entorno del sitio DATAWINT.
# Copia este archivo a .env.local para desarrollo. No subas .env.local al repositorio.
# Las variables NEXT_PUBLIC_* se incrustan en el frontend al compilar: NUNCA pongas secretos ni claves API aquí.

# URL del portal de clientes. Por defecto: https://app.datawint.com
NEXT_PUBLIC_PORTAL_URL=https://app.datawint.com

# "true" para que el botón "Portal de clientes" lleve al portal real.
# Cualquier otro valor (o vacío) lleva a /portal, que indica que el portal estará disponible próximamente.
# Mantener en "false" hasta que app.datawint.com esté publicado.
NEXT_PUBLIC_PORTAL_ENABLED=false
